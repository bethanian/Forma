<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Forma.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Forma.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Forma</Product>
    <Description>A native Windows media utility</Description>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <ProjectReference Include="../Forma.Core/Forma.Core.csproj" />
    <Content Include="../../worker/dreamy_worker.py" Link="worker/dreamy_worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/Forma.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishWinUIResources" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="Build">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri"><RelativePath>$(AssemblyName).pri</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf"><RelativePath>App.xbf</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
